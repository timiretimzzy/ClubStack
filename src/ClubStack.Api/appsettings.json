{
  "App": {
    "MigrateOnStartup": true,
    "StopOnMigrationFailure": true,
    "EnableDevelopmentSeed": false,
    "EnableBootstrap": true,
    "DevelopmentAdminUserName": "",
    "DevelopmentAdminPassword": "",
    "DevelopmentTools": true
  },
  "Security": {
    "RequiredLength": 12,
    "RequireDigits": true,
    "RequireLowercase": true,
    "RequireUppercase": true,
    "RequireNonAlphanumeric": true,
    "LockoutMaxFailedAttempts": 5,
    "LockoutDefaultTime": "00:15:00"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=clubstack;Username=clubstack;Password=${CLUBSTACK_DB_PASSWORD};Pooling=true;Maximum Pool Size=20"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{correlationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/clubstack-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{correlationId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}